# GitHub token (optional)
# Unauthenticated: 60 req/h. With token: 5000 req/h, and faster upstream-repo lookups.
GITHUB_TOKEN=

# ── LLM configuration (pick one of the three styles; LLM_* takes priority) ──

# Style 1: Anthropic-compatible (including local gateways, e.g. claude code gateways)
# ANTHROPIC_AUTH_TOKEN or ANTHROPIC_API_KEY — either one is enough
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Style 2: OpenAI-compatible (DeepSeek, GLM, OpenRouter, etc.)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Style 3: generic vars (highest priority; LLM_PROVIDER explicitly selects openai or anthropic)
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
